# AeroSync environment for docker compose. Copy to .env (ignored by git) and
# fill in the values. Never commit .env.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=aerosync
DB_USER=postgres
DB_PASSWORD=

# ── Authentication ──────────────────────────────────────────────────────────
# HS256 signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Left empty, the backend signs with a random key per start (sessions end on restart).
JWT_SECRET=
# Token lifetime in milliseconds (8 hours).
JWT_EXPIRATION=28800000

# ── Development-only demo accounts ──────────────────────────────────────────
# true creates the accounts below on startup (existing accounts are never
# changed). All of them use AEROSYNC_DEMO_PASSWORD (8+ characters; there is
# no default). Keep false in any shared or production environment.
AEROSYNC_DEMO_USERS_ENABLED=false
AEROSYNC_DEMO_PASSWORD=
# Optional: username=IATA[,IATA...]:ROLE;...  (roles: OPERATIONS_CONTROLLER, OPERATIONS_VIEWER)
# AEROSYNC_DEMO_USERS=bom.ops=BOM:OPERATIONS_CONTROLLER;del.ops=DEL:OPERATIONS_CONTROLLER;network.ops=BOM,DEL,BLR,HYD:OPERATIONS_CONTROLLER;bom.viewer=BOM:OPERATIONS_VIEWER

# ── External services (optional) ────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WEATHER_API_KEY=


# ── Data source mode (Stage 4) ──────────────────────────────────────────────
# SYNTHETIC  generated demonstration data only; needs no external API (default)
# LIVE       external data only (OpenSky aircraft and flights, observed weather)
# HYBRID     both, every record labelled with its source
AEROSYNC_DATA_MODE=SYNTHETIC

# ── OpenSky Network (used in LIVE and HYBRID mode) ──────────────────────────
# OAuth2 client credentials of an API client created on your OpenSky account
# page (https://opensky-network.org). Leave both empty for anonymous access:
# it works, but with about a tenth of the daily API credits, so AeroSync polls
# less often. OpenSky no longer accepts a username and password.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Wanted seconds between live aircraft polls. AeroSync raises this by itself
# when the daily credit budget cannot pay for it.
OPENSKY_STATES_POLL_SECONDS=300

# ── Disruption monitoring ───────────────────────────────────────────────────
# Detects potential disruptions and lists them for a controller. It never
# proposes, approves or executes anything by itself.
AEROSYNC_MONITORING_ENABLED=true

# INFO, or DEBUG for request-level detail.
AEROSYNC_LOG_LEVEL=INFO
